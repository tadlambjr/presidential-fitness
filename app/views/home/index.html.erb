<div class="min-h-screen bg-gradient-to-b from-blue-50 to-white">
  <!-- Hero Section -->
  <div class="bg-red-700 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="flex justify-center mb-4">
        <!-- Simple flag-like stripes -->
        <div class="w-64 h-2 bg-red-600"></div>
        <div class="w-64 h-2 bg-white"></div>
        <div class="w-64 h-2 bg-blue-800"></div>
      </div>
      <h1 class="text-5xl font-bold mb-4 tracking-tight">Presidential Fitness Test</h1>
      <p class="text-xl text-red-100 mb-6">Maple Row Homestead Edition</p>
      <p class="text-lg text-white/90 max-w-2xl mx-auto">
        Track your fitness progress with the same spirit as the President's National Fitness Test —
        because at Maple Row Homestead, <em>you</em> are the President.
      </p>
    </div>
  </div>

  <!-- About Section -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-4">About This Test</h2>
      <p class="text-gray-600 mb-4">
        The Presidential Fitness Test is a comprehensive fitness assessment that measures your
        strength, endurance, flexibility, and speed. This app lets you track your progress over time
        across all the classic metrics — and more.
      </p>
      <p class="text-gray-600">
        Whether you're training for competition, monitoring your health, or just want to see how
        you stack up, this test gives you the data you need to improve.
      </p>
    </div>

    <!-- Metrics Overview -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-6">Measured Metrics</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">Broad Jump (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">Shot Put / Softball Throw (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">Push-ups (max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">Sit-ups (60s max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">Chin-ups (max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">Pull-ups (max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">Handstand Hold (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">Wall Sit (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">Flexibility / Sit-and-Reach (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">Toe Reach (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">50-Yard Dash (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">1-Mile Run (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">Shuttle Run (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">Jump Rope (60s max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-600 rounded-full"></div>
          <span class="text-gray-700">Vertical Jump (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-600 rounded-full"></div>
          <span class="text-gray-700">Rope Climb (seconds)</span>
        </div>
      </div>
    </div>

    <!-- PDF Downloads Section -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-4">Download Tracking Sheets</h2>
      <p class="text-gray-600 mb-6">
        PDF tracking sheets coming soon! These will include:
      </p>
      <ul class="list-disc list-inside text-gray-600 space-y-2 mb-6">
        <li>Individual progress sheet — track your metrics over time on paper</li>
        <li>Group/family sheet — printable template for group testing events</li>
      </ul>
      <div class="flex space-x-4">
        <button class="bg-gray-400 text-white px-6 py-3 rounded-lg cursor-not-allowed" disabled>
          Individual Sheet (Coming Soon)
        </button>
        <button class="bg-gray-400 text-white px-6 py-3 rounded-lg cursor-not-allowed" disabled>
          Group Sheet (Coming Soon)
        </button>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="text-center">
      <% if logged_in? %>
        <%= link_to "Go to Dashboard", metrics_path, class: "bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors" %>
      <% else %>
        <div class="space-y-4">
          <div>
            <%= link_to "Sign Up", signup_path, class: "bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors inline-block" %>
          </div>
          <div>
            <%= link_to "Sign In", login_path, class: "text-blue-700 hover:text-blue-800 font-semibold text-lg" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
