<div class="min-h-screen bg-gradient-to-b from-blue-50 to-white">
  <!-- Hero Section -->
  <div class="bg-red-900 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <div class="flex justify-center mb-4">
        <!-- Simple flag-like stripes -->
        <div class="w-64 h-2 bg-red-800"></div>
        <div class="w-64 h-2 bg-gray-100"></div>
        <div class="w-64 h-2 bg-blue-900"></div>
      </div>
      <h1 class="text-5xl font-bold mb-4 tracking-tight">Presidential Fitness Test</h1>
      <p class="text-xl text-red-100 mb-6">Maple Row Homestead Edition</p>
      <p class="text-lg text-white/90 max-w-2xl mx-auto">
        Track your fitness progress with the same standards of excellence as the President's National Fitness Test —
        a tradition of achievement and performance at Maple Row Homestead.
      </p>
    </div>
  </div>

  <!-- About Section -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-4">Performance Standards</h2>
      <p class="text-gray-600 mb-4">
        The Presidential Fitness Test represents the highest standards in physical assessment, measuring
        strength, endurance, flexibility, and speed. This platform provides comprehensive tracking
        across all established metrics with data-driven insights for performance optimization.
      </p>
      <p class="text-gray-600">
        Designed for serious fitness tracking, whether you're training for competition, monitoring
        health metrics, or pursuing excellence in physical performance.
      </p>
    </div>

    <!-- Metrics Overview -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-6">Performance Metrics</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">Broad Jump (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">Pull-ups (max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">Plank (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">50-Yard Dash (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">Vertical Jump (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-800 rounded-full"></div>
          <span class="text-gray-700">Push-ups (max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-800 rounded-full"></div>
          <span class="text-gray-700">Toe Reach (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">Shuttle Run (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-800 rounded-full"></div>
          <span class="text-gray-700">Shot Put / Softball Throw (inches)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-800 rounded-full"></div>
          <span class="text-gray-700">Sit-ups (60s max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-800 rounded-full"></div>
          <span class="text-gray-700">Wall Sit (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">1-Mile Run (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">Chin-ups (max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-blue-800 rounded-full"></div>
          <span class="text-gray-700">Handstand Hold (seconds)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-800 rounded-full"></div>
          <span class="text-gray-700">Jump Rope (60s max reps)</span>
        </div>
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-red-800 rounded-full"></div>
          <span class="text-gray-700">Rope Climb (seconds)</span>
        </div>
      </div>
    </div>

    <!-- PDF Downloads Section -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-bold text-gray-800 mb-4">Performance Tracking</h2>
      <p class="text-gray-600 mb-6">
        Professional tracking sheets now available! These resources include:
      </p>
      <ul class="list-disc list-inside text-gray-600 space-y-2 mb-6">
        <li>Individual performance log — detailed metric tracking for personal optimization</li>
        <li>Group assessment template — professional format for team testing events</li>
      </ul>
      <div class="flex space-x-4">
        <%= link_to "Download Individual Performance Log", downloads_individual_performance_log_path, class: "bg-blue-800 hover:bg-blue-900 text-white px-6 py-3 rounded-lg font-semibold transition-colors" %>
        <%= link_to "Download Group Assessment Template", downloads_group_assessment_template_path, class: "bg-blue-800 hover:bg-blue-900 text-white px-6 py-3 rounded-lg font-semibold transition-colors" %>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="text-center">
      <% if logged_in? %>
        <%= link_to "Performance Dashboard", metrics_path, class: "bg-blue-800 hover:bg-blue-900 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors" %>
      <% else %>
        <div class="space-y-4">
          <div>
            <%= link_to "Sign Up", signup_path, class: "bg-blue-800 hover:bg-blue-900 text-white font-bold py-3 px-8 rounded-lg text-lg transition-colors inline-block" %>
          </div>
          <div>
            <%= link_to "Sign In", login_path, class: "text-blue-800 hover:text-blue-900 font-semibold text-lg" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
