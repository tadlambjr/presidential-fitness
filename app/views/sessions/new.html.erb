<div class="min-h-screen bg-gradient-to-b from-blue-50 to-white flex items-center justify-center py-12">
  <div class="max-w-md w-full mx-auto px-4">
    <div class="bg-white rounded-lg shadow-lg p-8">
      <h1 class="text-3xl font-bold text-gray-800 mb-2 text-center">Sign In</h1>
      <p class="text-gray-600 text-center mb-6">Welcome back!</p>

      <% flash[:alert] && flash.now[:alert] %>
      <% if flash[:alert] %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
          <p class="text-red-700"><%= flash[:alert] %></p>
        </div>
      <% end %>

      <%= form_with url: login_path, local: true, method: :post, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :username, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :username, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500", required: true %>
        </div>

        <div>
          <%= f.submit "Sign In", class: "w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 px-4 rounded-lg transition-colors cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-gray-600">
          Don't have an account?
          <%= link_to "Sign Up", signup_path, class: "text-blue-700 hover:text-blue-800 font-semibold" %>
        </p>
      </div>
    </div>
  </div>
</div>
