<div class="min-h-screen bg-gradient-to-b from-blue-50 to-white py-12">
  <div class="max-w-4xl mx-auto px-4">
    <div class="bg-white rounded-lg shadow-lg p-8">
      <h1 class="text-3xl font-bold text-gray-800 mb-2">Record Your Metrics</h1>
      <p class="text-gray-600 mb-6">All fields are optional — only fill in what you've measured today</p>

      <% if @metric_entry.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
          <h2 class="text-red-800 font-semibold mb-2">Errors:</h2>
          <ul class="list-disc list-inside text-red-700">
            <% @metric_entry.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @metric_entry, local: true, class: "space-y-6" do |f| %>
        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Date</h2>
          <div>
            <%= f.label :recorded_on, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.date_field :recorded_on, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
          </div>
        </div>

        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Explosive Power</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :broad_jump_inches, "Broad Jump (inches)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :broad_jump_inches, step: 0.1, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 78" (boys), 68" (girls)</p>
            </div>
            <div>
              <%= f.label :vertical_jump_inches, "Vertical Jump (inches)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :vertical_jump_inches, step: 0.1, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 20" (boys), 16" (girls)</p>
            </div>
            <div>
              <%= f.label :throw_distance_inches, "Shot Put / Softball Throw (inches)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :throw_distance_inches, step: 0.1, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 290" (boys), 240" (girls)</p>
            </div>
          </div>
        </div>

        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Upper Body Strength</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :pull_ups, "Pull-ups (max reps)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :pull_ups, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 10 (boys), 2 (girls)</p>
            </div>
            <div>
              <%= f.label :chin_ups, "Chin-ups (max reps)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :chin_ups, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 12 (boys), 4 (girls)</p>
            </div>
            <div>
              <%= f.label :push_ups, "Push-ups (max reps)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :push_ups, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 35 (boys), 20 (girls)</p>
            </div>
            <div>
              <%= f.label :rope_climb_seconds, "Rope Climb (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :rope_climb_seconds, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 12s (boys), 18s (girls)</p>
            </div>
          </div>
        </div>

        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Core & Stability</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :handstand_seconds, "Handstand Hold (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :handstand_seconds, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 20s (boys), 15s (girls)</p>
            </div>
            <div>
              <%= f.label :plank_seconds, "Plank (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :plank_seconds, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 180s (boys), 150s (girls)</p>
            </div>
            <div>
              <%= f.label :sit_ups, "Sit-ups (60s max reps)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :sit_ups, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 50 (boys), 42 (girls)</p>
            </div>
          </div>
        </div>

        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Lower Body Endurance</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :wall_sit_seconds, "Wall Sit (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :wall_sit_seconds, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 120s (boys), 105s (girls)</p>
            </div>
            <div>
              <%= f.label :jump_rope_reps, "Jump Rope (60s max reps)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :jump_rope_reps, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 140 (boys), 125 (girls)</p>
            </div>
          </div>
        </div>

        <div class="border-b border-gray-200 pb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Speed & Endurance</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :fifty_yard_dash_seconds, "50-Yard Dash (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :fifty_yard_dash_seconds, step: 0.01, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 7.2s (boys), 7.8s (girls)</p>
            </div>
            <div>
              <%= f.label :shuttle_run_seconds, "Shuttle Run (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :shuttle_run_seconds, step: 0.01, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 10.5s (boys), 11.3s (girls)</p>
            </div>
            <div>
              <%= f.label :one_mile_run_seconds, "1-Mile Run (seconds)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :one_mile_run_seconds, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 390s (boys), 450s (girls)</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Flexibility & Recovery</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.label :toe_reach_inches, "Toe Reach (inches)", class: "block text-sm font-medium text-gray-700 mb-1" %>
              <%= f.number_field :toe_reach_inches, step: 0.1, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
              <p class="text-xs text-gray-500 mt-1">Target: 6" (boys), 8" (girls)</p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Notes</h2>
          <div>
            <%= f.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= f.text_area :notes, rows: 3, class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
            <p class="text-xs text-gray-500 mt-1">Any additional notes about your performance</p>
          </div>
        </div>

        <div class="flex space-x-4">
          <%= f.submit "Save Metrics", class: "bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 px-6 rounded-lg transition-colors cursor-pointer" %>
          <%= link_to "Cancel", metrics_path, class: "bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-3 px-6 rounded-lg transition-colors" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
