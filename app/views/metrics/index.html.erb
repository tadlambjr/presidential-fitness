<div class="min-h-screen bg-gradient-to-b from-blue-50 to-white py-12">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl font-bold text-gray-800">Your Fitness History</h1>
      <%= link_to "Record New Metrics", new_metric_path, class: "bg-blue-700 hover:bg-blue-800 text-white font-bold py-2 px-4 rounded-lg transition-colors" %>
    </div>

    <% if @metric_entries.empty? %>
      <div class="bg-white rounded-lg shadow-lg p-8 text-center">
        <p class="text-gray-600 mb-4">No metrics recorded yet.</p>
        <%= link_to "Record your first entry", new_metric_path, class: "text-blue-700 hover:text-blue-800 font-semibold" %>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow-lg overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Broad Jump</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Throw</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Push-ups</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Sit-ups</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Chin-ups</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Pull-ups</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Handstand</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Wall Sit</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Flex</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Toe Reach</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">50yd</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">1mi</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Shuttle</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Jump Rope</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Vert</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Rope</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @metric_entries.each do |entry| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                    <%= entry.recorded_on.strftime("%b %d, %Y") %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.broad_jump_inches ? "#{entry.broad_jump_inches}\"" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.throw_distance_inches ? "#{entry.throw_distance_inches}\"" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.push_ups || "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.sit_ups || "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.chin_ups || "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.pull_ups || "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.handstand_seconds ? "#{entry.handstand_seconds}s" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.wall_sit_seconds ? "#{entry.wall_sit_seconds}s" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.flexibility_inches ? "#{entry.flexibility_inches}\"" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.toe_reach_inches ? "#{entry.toe_reach_inches}\"" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.fifty_yard_dash_seconds ? "#{entry.fifty_yard_dash_seconds}s" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <% if entry.one_mile_run_seconds %>
                      <% mins = entry.one_mile_run_seconds / 60 %>
                      <% secs = entry.one_mile_run_seconds % 60 %>
                      <%= "#{mins}:#{secs.to_s.rjust(2, '0')}" %>
                    <% else %>
                      -
                    <% end %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.shuttle_run_seconds ? "#{entry.shuttle_run_seconds}s" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.jump_rope_reps || "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.vertical_jump_inches ? "#{entry.vertical_jump_inches}\"" : "-" %>
                  </td>
                  <td class="px-4 py-4 whitespace-nowrap text-sm text-gray-600">
                    <%= entry.rope_climb_seconds ? "#{entry.rope_climb_seconds}s" : "-" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <% if @metric_entries.any?(&:notes) %>
        <div class="mt-8 bg-white rounded-lg shadow-lg p-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Notes</h2>
          <% @metric_entries.select(&:notes).each do |entry| %>
            <div class="mb-4 pb-4 border-b border-gray-200 last:border-0">
              <p class="text-sm font-medium text-gray-700 mb-1">
                <%= entry.recorded_on.strftime("%B %d, %Y") %>
              </p>
              <p class="text-gray-600"><%= entry.notes %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
