# Kamal deployment secrets
# Copy this file to .env and fill in the actual values before deploying

# GitHub Container Registry password
# Create a GitHub Personal Access Token at https://github.com/settings/tokens
# Token must have 'write:packages' scope
KAMAL_REGISTRY_PASSWORD=your_github_pat_here

# Rails master key (found in config/master.key)
RAILS_MASTER_KEY=your_rails_master_key_here
